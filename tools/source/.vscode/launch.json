{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "TARGET",
      "type": "pickString",
      "description": "Select target",
      "options": [
        "ffxiso",
        "ffxftcx",
        "ffxname",
        "ffxppkg",
        "font_adjustment",
        "ffx_international_kr"
      ],
      "default": "ffxiso"
    }
  ],
  "configurations": [
    {
      "name": "Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/${input:TARGET}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/debug/bin",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "${env:MSYS2_HOME}/mingw64/bin/gdb.exe",
      "preLaunchTask": "build.${input:TARGET}",
      "internalConsoleOptions": "neverOpen",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "set print unicode on",
          "ignoreFailures": true
        },
        {
          "text": "set target-charset UTF-8",
          "ignoreFailures": true
        },
        {
          "text": "set host-charset UTF-8",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
