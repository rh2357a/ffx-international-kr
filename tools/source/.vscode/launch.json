{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run (ffxiso)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\debug\\bin\\ffxiso.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\build\\debug\\bin",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "${env:MSYS2_HOME}\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "build.ffxiso",
      "internalConsoleOptions": "neverOpen",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "set print unicode on",
          "ignoreFailures": true
        },
        {
          "text": "set target-charset UTF-8",
          "ignoreFailures": true
        },
        {
          "text": "set host-charset UTF-8",
          "ignoreFailures": true
        }
      ]
